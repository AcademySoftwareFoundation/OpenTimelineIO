{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Format Python",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--only-group",
        "lint",
        "python",
        "maintainers/format_python.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Check Python formatting",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--only-group",
        "lint",
        "python",
        "maintainers/format_python.py",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Python: Sync environment",
      "type": "process",
      "command": "uv",
      "args": [
        "sync",
        "--locked"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Python: Rebuild extensions",
      "type": "process",
      "command": "uv",
      "args": [
        "sync",
        "--locked",
        "--reinstall-package",
        "opentimelineio"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Python: Run tests",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Python: Test until first failure",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "--failfast"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Python: Coverage",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "make",
        "coverage",
        "UV_RUN=uv run --no-sync"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Python: Lint",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "ruff",
        "check",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Python: Build distributions",
      "type": "process",
      "command": "uv",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Python: Build wheel",
      "type": "process",
      "command": "uv",
      "args": [
        "build",
        "--wheel"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Python: Build source distribution",
      "type": "process",
      "command": "uv",
      "args": [
        "build",
        "--sdist"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Docs: Build HTML",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--group",
        "docs",
        "make",
        "-C",
        "docs",
        "html"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Docs: Check warnings",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--group",
        "docs",
        "make",
        "-C",
        "docs",
        "htmlstrict"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Docs: Check links",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--group",
        "docs",
        "make",
        "-C",
        "docs",
        "linkcheck"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Docs: Serve HTML",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--group",
        "docs",
        "python",
        "-m",
        "http.server",
        "8000",
        "--directory",
        "docs/_build/html"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "C++: Configure",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "${input:cppPreset}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "C++: Build",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "${input:cppPreset}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "C++: Run tests",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "${input:cppPreset}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "C++: Install SDK",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "${input:cppPreset}",
        "--target",
        "install"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    }
  ],
  "inputs": [
    {
      "id": "cppPreset",
      "type": "pickString",
      "description": "C++ toolchain: dev on the host, vfx2026 inside the devcontainer",
      "options": [
        "dev",
        "vfx2026"
      ],
      "default": "dev"
    }
  ]
}
